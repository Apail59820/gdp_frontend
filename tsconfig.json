{
  "extends": "./node_modules/@projex/tsconfig/nextjs.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "compilerOptions": {
    "target": "ES5",
    "downlevelIteration": true,
    "moduleResolution": "Node",
    "plugins": [
      {
        "name": "next"
      }
    ]
  }
}
